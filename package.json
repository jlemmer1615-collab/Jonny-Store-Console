{
  "name": "jonny-store-console",
  "version": "1.0.0",
  "description": "Private eBay seller console on GitHub Pages and Supabase Edge Functions",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-public-config.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/database.test.ts",
    "test:ui": "playwright test",
    "check:edge": "deno check --node-modules-dir=manual --config supabase/functions/deno.json supabase/functions/console-api/index.ts supabase/functions/ebay-callback/index.ts supabase/functions/scheduled-jobs/index.ts",
    "test:dom": "vitest run"
  },
  "keywords": [],
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "deno": "^2.9.6",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.0.18"
  },
  "private": true
}

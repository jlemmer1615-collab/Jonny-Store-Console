# Set these through Supabase Dashboard > Edge Functions > Secrets.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to the runtime automatically.
APP_URL=https://jlemmer1615-collab.github.io/Jonny-Store-Console/
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID
EBAY_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET
EBAY_RUNAME=YOUR_SANDBOX_REDIRECT_URL_NAME
CRON_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
LIVE_WRITES_ENABLED=false
